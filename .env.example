# Copy to .env.local for local work, and set the same names in the Vercel
# project under Settings -> Environment Variables. .env*.local is gitignored;
# this example file is not, and must never hold a real key.

# --- Contact form delivery -------------------------------------------------
# Without these the form still works: /api/contact answers 503 and the page
# falls back to opening the visitor's mail client with their message already
# written. Nothing is lost either way — but nothing reaches an inbox on its
# own until these are set.

# resend.com -> API Keys. Free tier covers 3,000 emails a month.
RESEND_API_KEY=

# Where enquiries should land.
CONTACT_TO=admin@vioniche.com

# Optional. Defaults to Resend's shared onboarding@resend.dev, which works
# immediately but is not your domain. To send as your own address, verify the
# domain in Resend and put something like "Vioniche <admin@vioniche.com>"
# here.
CONTACT_FROM=

# --- Admin CMS (/admin) ------------------------------------------------------
# See docs/cms-setup.md. Without these three, /admin cannot be signed in to.

# The one admin's user ID — what goes in the "User ID" box at /admin/login.
ADMIN_USER_ID=
# Not the password — its scrypt hash. Generate with: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
# Signs the session cookie. At least 32 characters: openssl rand -base64 48
SESSION_SECRET=

# --- GitHub publishing (GitHub App) ------------------------------------------
# Without these, the CMS works locally in `npm run dev` (writing to this
# checkout) and refuses to save in production.

GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# The app's private key (PEM). Paste it whole; literal "\n" is also accepted.
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPOSITORY=remondanthony/portfolio
GITHUB_BRANCH=main

# --- Projects (the CMS's Project menu) ---------------------------------------
# Vioniche uses GITHUB_REPOSITORY above. Born21 has its own repository, reached
# through the same GitHub App (add the repository to the app's installation).
# Default: remondanthony/Born21 — the Born21 site's own git remote.
BORN21_GITHUB_REPOSITORY=remondanthony/Born21
BORN21_GITHUB_BRANCH=main
# Only if Born21 is reached through a different installation of the app.
BORN21_GITHUB_APP_INSTALLATION_ID=

# --- Google Search Console (Vioniche only) ---------------------------------
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web
# application). See docs/cms-setup.md section 6. Without these, the Search
# Console screen says it is not configured; nothing else changes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must equal an "Authorized redirect URI" of that client, character for character:
#   https://<your production domain>/api/search-console/callback
#   http://localhost:3001/api/search-console/callback   (local development)
GOOGLE_OAUTH_REDIRECT_URI=
